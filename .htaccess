# ==========================================================================
# Apache / Locaweb Configuration - JC Food Delivery PWA
# ==========================================================================

# Charset padrão UTF-8 para prevenir problemas de acentuação
AddDefaultCharset UTF-8

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Forçar HTTPS seguro (PWA requer HTTPS para Service Worker e Notificações)
    RewriteCond %{HTTPS} off
    RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
</IfModule>

# MIME Types Corretos
<IfModule mod_mime.c>
    AddType application/json .json
    AddType application/manifest+json .webmanifest
    AddType application/javascript .js
    AddType text/css .css
    AddType image/svg+xml .svg
    AddType image/webp .webp
    AddType font/woff2 .woff2
    AddType font/woff .woff
    AddType font/ttf .ttf
</IfModule>

# Controle de Cache e Headers HTTP
<IfModule mod_headers.c>
    # Service Worker e Manifesto NUNCA devem ser cacheados (garante atualizações instantâneas)
    <FilesMatch "^(sw\.js|manifest\.json)$">
        Header set Cache-Control "no-cache, no-store, must-revalidate, max-age=0"
        Header set Pragma "no-cache"
        Header set Expires "0"
    </FilesMatch>

    # Arquivos HTML e JSON de dados sempre frescos
    <FilesMatch "\.(html|htm|json)$">
        Header set Cache-Control "no-cache, no-store, must-revalidate, max-age=0"
        Header set Pragma "no-cache"
        Header set Expires "0"
    </FilesMatch>

    # Scripts e CSS com revalidação
    <FilesMatch "\.(js|css)$">
        Header set Cache-Control "public, max-age=3600, must-revalidate"
    </FilesMatch>

    # Imagens e Fontes Estáticas com cache longo
    <FilesMatch "\.(png|jpg|jpeg|gif|webp|svg|ico|woff2?|ttf)$">
        Header set Cache-Control "public, max-age=604800, stale-while-revalidate=86400"
        Header set Access-Control-Allow-Origin "*"
    </FilesMatch>

    # Segurança Básica
    Header set X-Content-Type-Options "nosniff"
    Header set X-XSS-Protection "1; mode=block"
</IfModule>

# Compressão GZIP / Deflate para alta velocidade de carregamento
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css application/javascript application/json application/manifest+json image/svg+xml
</IfModule>
