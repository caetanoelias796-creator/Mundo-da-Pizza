{
  "rules": {
    "menu": {
      ".read": true,
      ".write": "auth != null"
    },
    "status": {
      ".read": true,
      ".write": "auth != null"
    },
    "orders": {
      ".read": "auth != null",
      ".write": "auth != null",
      "$orderId": {
        ".read": "auth != null",
        ".write": "!data.exists() || auth != null"
      }
    },
    "backups": {
      ".read": "auth != null",
      ".write": "auth != null"
    }
  }
}
